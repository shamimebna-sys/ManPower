                        @if ($isServerSide)
                            <div class="pull-left">
                                <div role="status" class="show-res" aria-live="polite">{{ trans_choice(
                                    'voyager::generic.showing_entries', $dataTypeContent->total(), [
                                        'from' => $dataTypeContent->firstItem(),
                                        'to' => $dataTypeContent->lastItem(),
                                        'all' => $dataTypeContent->total()
                                    ]) }}</div>
                            </div>
                            <div class="pull-right" style="display: none">
                                {{ $dataTypeContent->appends([
                                    's' => $search->value,
                                    'filter' => $search->filter,
                                    'key' => $search->key,
                                    'search_group' => $search->search_group,
                                    'search_agent' => $search->search_agent,
                                    'search_agency' => $search->search_agency,
                                    'search_license_status' => $search->search_license_status,
                                    'order_by' => $orderBy,
                                    'sort_order' => $sortOrder,
                                    'showSoftDeleted' => $showSoftDeleted,
                                ])->links() }}
                            </div>

                            <div class="pull-right">
                                <ul class="pagination">
                                    {{-- Previous Page Link --}}
                                    @if ($dataTypeContent->onFirstPage())
                                        <li class="page-item disabled"><span class="page-link">&laquo;</span></li>
                                    @else
                                        <li class="page-item">
                                            <a class="page-link" href="{{ $dataTypeContent->previousPageUrl() }}" rel="prev">&laquo;</a>
                                        </li>
                                    @endif

                                    {{-- Pagination Numbers with Ellipsis --}}
                                    @php
                                        $current = $dataTypeContent->currentPage();
                                        $last = $dataTypeContent->lastPage();
                                        $start = max(1, $current - 2);
                                        $end = min($last, $current + 2);
                                    @endphp

                                    {{-- Always show first 2 pages --}}
                                    @for ($i = 1; $i <= min(2, $last); $i++)
                                        <li class="page-item {{ $current == $i ? 'active' : '' }}">
                                            <a class="page-link" href="{{ $dataTypeContent->url($i) }}">{{ $i }}</a>
                                        </li>
                                    @endfor

                                    {{-- Ellipsis if needed before middle --}}
                                    @if ($start > 3)
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    @endif

                                    {{-- Middle pages --}}
                                    @for ($i = $start; $i <= $end; $i++)
                                        @if ($i > 2 && $i < $last - 1)
                                            <li class="page-item {{ $current == $i ? 'active' : '' }}">
                                                <a class="page-link" href="{{ $dataTypeContent->url($i) }}">{{ $i }}</a>
                                            </li>
                                        @endif
                                    @endfor

                                    {{-- Ellipsis if needed after middle --}}
                                    @if ($end < $last - 2)
                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                    @endif

                                    {{-- Always show last 2 pages --}}
                                    @for ($i = max($last - 1, 1); $i <= $last; $i++)
                                        <li class="page-item {{ $current == $i ? 'active' : '' }}">
                                            <a class="page-link" href="{{ $dataTypeContent->url($i) }}">{{ $i }}</a>
                                        </li>
                                    @endfor

                                    {{-- Next Page Link --}}
                                    @if ($dataTypeContent->hasMorePages())
                                        <li class="page-item">
                                            <a class="page-link" href="{{ $dataTypeContent->nextPageUrl() }}" rel="next">&raquo;</a>
                                        </li>
                                    @else
                                        <li class="page-item disabled"><span class="page-link">&raquo;</span></li>
                                    @endif
                                </ul>
                            </div>



                        @endif
                    </div>
                </div>
            </div>
        </div>
    </div>

