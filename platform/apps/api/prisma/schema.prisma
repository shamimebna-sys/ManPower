/// Rapid Interview person identity. Not one of the four A05 partner masters.
model Employer {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceLegacyId BigInt?  @unique @map("source_legacy_id")
  code           String?  @db.VarChar(100)
  name           String?  @db.VarChar(255)
  email          String?  @db.VarChar(255)
  mobile         String?  @db.VarChar(255)
  status         String   @default("A") @db.VarChar(5)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  boundUsers  User[]
  assignments EmployerCandidate[]

  @@index([status])
  @@index([name])
  @@map("employers")
  @@schema("partners")
}

model EmployerCandidate {
  id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employerId  String                    @map("employer_id") @db.Uuid
  candidateId String                    @map("candidate_id") @db.Uuid
  purpose     EmployerCandidatePurpose
  status      String                    @default("A") @db.VarChar(5)
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  employer  Employer  @relation(fields: [employerId], references: [id], onDelete: Restrict)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([employerId, status])
  @@index([candidateId, status])
  @@index([employerId, candidateId, purpose, status])
  @@map("employer_candidates")
  @@schema("partners")
}
