// ============================================================
// Prisma Schema — ManPower Platform
// ============================================================
// M1 foundation + M2 IAM/audit + M3 candidate master + M4 profile children
// + M4 recruitment (partner masters, user bindings, employer_candidates).
// Sequence candidate.candidate_code_seq allocates new fallback codes (9######).
// Later business models are added only in approved milestones.
//
// Business models will be added in M2–M13 following the
// approved migration design in:
//   modernization-design/final-design-gate/
//
// DO NOT add the 90 legacy MariaDB tables here directly.
// Every table addition requires a milestone-specific approval.
//
// Source database:  MariaDB/MySQL (legacy, READ-ONLY, in src/)
// Target database:  PostgreSQL (this schema)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["audit", "candidate", "iam", "migration", "partners"]
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@schema("iam")
}

model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String        @unique @db.VarChar(320)
  username     String?       @unique @db.VarChar(100)
  displayName  String        @map("display_name") @db.VarChar(200)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  status       AccountStatus @default(ACTIVE)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  agentId      String?       @map("agent_id") @db.Uuid
  subAgentId   String?       @map("sub_agent_id") @db.Uuid
  agencierId   String?       @map("agencier_id") @db.Uuid
  companierId  String?       @map("companier_id") @db.Uuid
  candidateId  String?       @map("candidate_id") @db.Uuid
  employerId   String?       @map("employer_id") @db.Uuid

  roles        UserRole[]
  sessions     Session[]
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: Restrict)
  subAgent     SubAgent?     @relation(fields: [subAgentId], references: [id], onDelete: Restrict)
  agencier     Agencier?     @relation(fields: [agencierId], references: [id], onDelete: Restrict)
  companier    Companier?    @relation(fields: [companierId], references: [id], onDelete: Restrict)
  candidate    Candidate?    @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  employer     Employer?     @relation(fields: [employerId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([agentId])
  @@index([subAgentId])
  @@index([agencierId])
  @@index([companierId])
  @@index([candidateId])
  @@index([employerId])
  @@map("users")
  @@schema("iam")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
  @@schema("iam")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(150)
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
  @@schema("iam")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?  @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
  @@schema("iam")
}

model RolePermission {
  roleId      String   @map("role_id") @db.Uuid
  permissionId String  @map("permission_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedBy   String?  @map("granted_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
  @@schema("iam")
}

model Session {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  csrfHash     String    @map("csrf_hash") @db.Char(64)
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("sessions")
  @@schema("iam")
}

model AuditEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     String   @map("event_type") @db.VarChar(120)
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  targetType    String?  @map("target_type") @db.VarChar(120)
  targetId      String?  @map("target_id") @db.VarChar(255)
  ipAddress     String?  @map("ip_address") @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  requestId     String?  @map("request_id") @db.VarChar(100)
  metadata      Json?
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([eventType, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([targetType, targetId])
  @@map("audit_events")
  @@schema("audit")
}

// ============================================================
// M3 — Candidate master (KEEP, no physical split)
// All 79 legacy candidates columns are represented.
// Relationship IDs are opaque integers: no speculative FKs.
// Payment IDs are opaque evidence only: finance is not implemented.
// File fields store private references (JSON/path), never public URLs.
// ============================================================

model Candidate {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String? @unique @db.VarChar(100)
  name      String? @db.VarChar(100)
  email     String? @db.VarChar(250)
  secondaryEmail String? @map("secondary_email") @db.VarChar(250)
  mobile    String? @db.VarChar(250)
  secondaryMobile String? @map("secondary_mobile") @db.VarChar(250)
  emergencyMobile String? @map("emergency_mobile") @db.VarChar(250)
  bid       String? @db.VarChar(250)
  bidFileRef String? @map("bid_file_ref") @db.Text
  nid       String? @db.VarChar(250)
  nidFileRef String? @map("nid_file_ref") @db.Text
  passportNo String? @map("passport_no") @db.VarChar(250)
  passportIssueDate DateTime? @map("passport_issue_date") @db.Date
  passportExpireDate DateTime? @map("passport_expire_date") @db.Date
  passportFileRef String? @map("passport_file_ref") @db.Text
  dob       DateTime? @db.Date
  fullPhotoFileRef String? @map("full_photo_file_ref") @db.Text
  halfPhotoFileRef String? @map("half_photo_file_ref") @db.Text
  fatherName String? @map("father_name") @db.VarChar(250)
  motherName String? @map("mother_name") @db.VarChar(250)
  nationality String? @db.VarChar(250)
  gender    String? @db.VarChar(20)
  bloodGroup String? @map("blood_group") @db.VarChar(20)
  presentAddressHouse String? @map("present_address_house") @db.VarChar(200)
  presentAddressRoad String? @map("present_address_road") @db.VarChar(20)
  presentAddressVillage String? @map("present_address_village") @db.VarChar(20)
  presentAddressPost String? @map("present_address_post") @db.VarChar(20)
  presentAddressThanaId BigInt? @map("present_address_thana_id")
  presentAddressDistrictId BigInt? @map("present_address_district_id")
  presentAddressDivisionId BigInt? @map("present_address_division_id")
  permanentAddressHouse String? @map("permanent_address_house") @db.VarChar(200)
  permanentAddressRoad String? @map("permanent_address_road") @db.VarChar(20)
  permanentAddressVillage String? @map("permanent_address_village") @db.VarChar(20)
  permanentAddressPost String? @map("permanent_address_post") @db.VarChar(20)
  permanentAddressThanaId BigInt? @map("permanent_address_thana_id")
  permanentAddressDistrictId BigInt? @map("permanent_address_district_id")
  permanentAddressDivisionId BigInt? @map("permanent_address_division_id")
  basicInfoCareer String? @map("basic_info_career") @db.Text
  basicInfoSpecial String? @map("basic_info_special") @db.Text
  otherSkills String? @map("other_skills") @db.Text
  balance   Decimal @default(0) @db.Decimal(20, 6)
  cvFileRef String? @map("cv_file_ref") @db.Text
  /// Legacy account status codes: A=active, P=pending, I=inactive. Unknown imported values remain as-is.
  status    String  @default("A") @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  agentId   BigInt? @map("agent_id")
  classGroupId BigInt? @map("class_group_id")
  remarks   String? @db.VarChar(255)
  replacementRemarks String? @map("replacement_remarks") @db.Text
  admissionPaymentId BigInt? @map("admission_payment_id")
  finalGroupPaymentId BigInt? @map("final_group_payment_id")
  medicalFeePaymentId BigInt? @map("medical_fee_payment_id")
  abroadEx  Int @default(0) @map("abroad_ex")
  localEx   Int @default(0) @map("local_ex")
  driveLink String? @map("drive_link") @db.VarChar(250)
  facebookLink String? @map("facebook_link") @db.VarChar(250)
  youtubeLink String? @map("youtube_link") @db.VarChar(250)
  linkedinLink String? @map("linkedin_link") @db.VarChar(250)
  twitterLink String? @map("twitter_link") @db.VarChar(250)
  instagramLink String? @map("instagram_link") @db.VarChar(250)
  position  String? @db.VarChar(250)
  skillCertificateFileRef String? @map("skill_certificate_file_ref") @db.Text
  height    String? @db.VarChar(100)
  weight    String? @db.VarChar(100)
  maritalStatus String? @map("marital_status") @db.VarChar(100)
  expertise String? @db.Text
  skills    String? @db.Text
  extraCurricular String? @map("extra_curricular") @db.Text
  interest  String? @db.Text
  attribute String? @db.Text
  companierId BigInt? @map("companier_id")
  agencierId BigInt? @map("agencier_id")
  stampFileRef String? @map("stamp_file_ref") @db.Text
  positionId BigInt? @map("position_id")
  companyStatus String? @default("ACTIVE") @map("company_status") @db.VarChar(200)
  subAgentId BigInt? @map("sub_agent_id")
  countryId BigInt? @map("country_id")
  replacedByLegacyId BigInt? @map("replaced_by_legacy_id")

  educations CandidateEducation[]
  experiences CandidateExperience[]
  skillRecords CandidateSkill[]
  skillTags  CandidateSkillTag[]
  languageRecords CandidateLanguage[]
  trainingRecords CandidateTraining[]
  boundUsers User[]
  employerAssignments EmployerCandidate[]

  @@unique([email])
  @@unique([mobile])
  @@unique([passportNo])
  @@index([status])
  @@index([name])
  @@index([nid])
  @@index([createdAt])
  @@map("candidates")
  @@schema("candidate")
}

model LegacyKeyMap {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceSystem   String   @map("source_system") @db.VarChar(100)
  sourceTable    String   @map("source_table") @db.VarChar(120)
  sourceId       String   @map("source_id") @db.VarChar(64)
  targetType     String   @map("target_type") @db.VarChar(120)
  targetId       String   @map("target_id") @db.VarChar(64)
  migrationRunId String?  @map("migration_run_id") @db.VarChar(100)
  sourceRowHash  String?  @map("source_row_hash") @db.VarChar(128)
  migratedAt     DateTime @default(now()) @map("migrated_at") @db.Timestamptz(6)

  @@unique([sourceSystem, sourceTable, sourceId])
  @@index([targetType, targetId])
  @@map("legacy_key_map")
  @@schema("migration")
}

// ============================================================
// M4 — Candidate supporting profile domains
// Confirmed child tables are candidate-owned (legacy user_id via users.candidate_id).
// manpower_trainings is a later workflow domain and is not modeled here.
// skill_list is NOT a global skill master (0 rows, user-scoped names).
// language_list is NOT a language master (user-scoped name + free-text status).
// country_id on experiences/trainings is varchar text in source — no FK.
// ============================================================

model CandidateEducation {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId        String    @map("candidate_id") @db.Uuid
  sourceUserId       BigInt?   @map("source_user_id")
  examName           String?   @map("exam_name") @db.VarChar(250)
  instituteName      String?   @map("institute_name") @db.VarChar(250)
  subjectGroupMajor  String?   @map("subject_group_major") @db.VarChar(250)
  educationLabel     String?   @map("education_label") @db.VarChar(250)
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  durationYear       Int?      @map("duration_year")
  resultType         String?   @map("result_type") @db.VarChar(250)
  result             String?   @db.VarChar(250)
  achievements       String?   @db.VarChar(250)
  certificateFileRef String?   @map("certificate_file_ref") @db.VarChar(250)
  status             String    @default("A") @db.VarChar(5)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByLegacyId  BigInt?   @map("created_by_legacy_id")
  updatedByLegacyId  BigInt?   @map("updated_by_legacy_id")
  boardName          String?   @map("board_name") @db.VarChar(200)
  scale              String?   @db.VarChar(200)
  passingYear        String?   @map("passing_year") @db.VarChar(200)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([candidateId, createdAt])
  @@index([candidateId, status])
  @@map("educations")
  @@schema("candidate")
}

model CandidateExperience {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId       String    @map("candidate_id") @db.Uuid
  sourceUserId      BigInt?   @map("source_user_id")
  companyName       String?   @map("company_name") @db.VarChar(250)
  companyAddress    String?   @map("company_address") @db.VarChar(250)
  countryRef        String?   @map("country_ref") @db.VarChar(250)
  designation       String?   @db.VarChar(250)
  department        String?   @db.VarChar(250)
  startDate         DateTime? @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  responsibilities  String?   @db.Text
  expertise         String?   @db.Text
  descriptions      String?   @db.Text
  achievements      String?   @db.VarChar(250)
  status            String    @default("A") @db.VarChar(5)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByLegacyId BigInt?   @map("created_by_legacy_id")
  updatedByLegacyId BigInt?   @map("updated_by_legacy_id")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([candidateId, createdAt])
  @@index([candidateId, status])
  @@map("experiences")
  @@schema("candidate")
}

model CandidateSkill {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId        String    @map("candidate_id") @db.Uuid
  sourceUserId       BigInt?   @map("source_user_id")
  title              String?   @db.VarChar(250)
  instituteName      String?   @map("institute_name") @db.VarChar(250)
  details            String?   @db.VarChar(250)
  resultScore        Decimal?  @map("result_score") @db.Decimal(10, 2)
  examScore          Decimal?  @map("exam_score") @db.Decimal(10, 2)
  certificateFileRef String?   @map("certificate_file_ref") @db.VarChar(250)
  status             String    @default("A") @db.VarChar(5)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByLegacyId  BigInt?   @map("created_by_legacy_id")
  updatedByLegacyId  BigInt?   @map("updated_by_legacy_id")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([candidateId, createdAt])
  @@index([candidateId, status])
  @@map("skills")
  @@schema("candidate")
}

/// Legacy skill_list: user-scoped skill names, not a global master. Dump has 0 rows.
model CandidateSkillTag {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId  String   @map("candidate_id") @db.Uuid
  sourceUserId BigInt?  @map("source_user_id")
  skillName    String?  @map("skill_name") @db.VarChar(255)
  status       String   @default("A") @db.VarChar(5)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([candidateId, createdAt])
  @@map("skill_list")
  @@schema("candidate")
}

/// Legacy language_list: candidate-specific rows, not a language catalogue.
model CandidateLanguage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId    String   @map("candidate_id") @db.Uuid
  sourceUserId   BigInt?  @map("source_user_id")
  languageName   String?  @map("language_name") @db.VarChar(255)
  languageStatus String?  @map("language_status") @db.VarChar(255)
  status         String   @default("A") @db.VarChar(5)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([candidateId, createdAt])
  @@map("language_list")
  @@schema("candidate")
}

model CandidateTraining {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId        String    @map("candidate_id") @db.Uuid
  sourceUserId       BigInt?   @map("source_user_id")
  title              String?   @db.VarChar(250)
  instituteName      String?   @map("institute_name") @db.VarChar(250)
  topics             String?   @db.VarChar(250)
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  duration           Int?
  durationType       String?   @map("duration_type") @db.VarChar(10)
  countryRef         String?   @map("country_ref") @db.VarChar(250)
  descriptions       String?   @db.VarChar(250)
  achievements       String?   @db.VarChar(250)
  certificateFileRef String?   @map("certificate_file_ref") @db.VarChar(250)
  address            String?   @db.VarChar(200)
  status             String    @default("A") @db.VarChar(5)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByLegacyId  BigInt?   @map("created_by_legacy_id")
  updatedByLegacyId  BigInt?   @map("updated_by_legacy_id")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([candidateId, createdAt])
  @@index([candidateId, status])
  @@map("trainings")
  @@schema("candidate")
}

// ============================================================
// M4 — Recruitment partner masters (A05) and employer assignment (A20)
// Live masters only: Agent, SubAgent, Agencier, Companier.
// Agency/Company snapshots are NOT modeled here.
// Employer is a Rapid Interview person identity, not a partner master.
// Teacher has no safe M4 candidate scope — no Teacher table here.
// candidate.*_id BigInt columns remain opaque lineage; scope compares
// those integers to partners.source_legacy_id after user UUID binding.
// Balance is opaque evidence. No finance operations.
// ============================================================

enum EmployerCandidatePurpose {
  FAVORITE
  RESERVE
  SELECTED

  @@schema("partners")
}

model Agent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceLegacyId BigInt?  @unique @map("source_legacy_id")
  code           String?  @db.VarChar(100)
  name           String?  @db.VarChar(255)
  email          String?  @db.VarChar(255)
  mobile         String?  @db.VarChar(255)
  address        String?  @db.VarChar(255)
  status         String   @default("A") @db.VarChar(5)
  countryId      BigInt?  @map("country_id")
  balance        Decimal  @default(0) @db.Decimal(20, 6)
  logoFileRef    String?  @map("logo_file_ref") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subAgents  SubAgent[]
  boundUsers User[]

  @@index([status])
  @@index([name])
  @@map("agents")
  @@schema("partners")
}

model SubAgent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceLegacyId BigInt?  @unique @map("source_legacy_id")
  agentId        String   @map("agent_id") @db.Uuid
  code           String?  @db.VarChar(100)
  name           String?  @db.VarChar(255)
  email          String?  @db.VarChar(255)
  mobile         String?  @db.VarChar(255)
  address        String?  @db.VarChar(255)
  status         String   @default("A") @db.VarChar(5)
  countryId      BigInt?  @map("country_id")
  balance        Decimal  @default(0) @db.Decimal(20, 6)
  logoFileRef    String?  @map("logo_file_ref") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  agent      Agent   @relation(fields: [agentId], references: [id], onDelete: Restrict)
  boundUsers User[]

  @@index([agentId])
  @@index([status])
  @@index([name])
  @@map("sub_agents")
  @@schema("partners")
}

model Agencier {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceLegacyId  BigInt?  @unique @map("source_legacy_id")
  code            String?  @db.VarChar(100)
  name            String?  @db.VarChar(255)
  email           String?  @db.VarChar(255)
  mobile          String?  @db.VarChar(255)
  licenseNo       String?  @map("license_no") @db.VarChar(255)
  vatNo           String?  @map("vat_no") @db.VarChar(255)
  address         String?  @db.VarChar(255)
  status          String   @default("A") @db.VarChar(5)
  countryId       BigInt?  @map("country_id")
  ownerName       String?  @map("owner_name") @db.VarChar(255)
  ownerMobile     String?  @map("owner_mobile") @db.VarChar(255)
  ownerEmail      String?  @map("owner_email") @db.VarChar(255)
  bankAccountName String?  @map("bank_account_name") @db.VarChar(200)
  bankAccountNo   String?  @map("bank_account_no") @db.VarChar(200)
  bankName        String?  @map("bank_name") @db.VarChar(200)
  bankBranchName  String?  @map("bank_branch_name") @db.VarChar(200)
  bankIbanNo      String?  @map("bank_iban_no") @db.VarChar(200)
  bankSwiftNo     String?  @map("bank_swift_no") @db.VarChar(200)
  balance         Decimal  @default(0) @db.Decimal(20, 6)
  logoFileRef     String?  @map("logo_file_ref") @db.Text
  signatureFileRef String? @map("signature_file_ref") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  boundUsers User[]

  @@index([status])
  @@index([name])
  @@map("agenciers")
  @@schema("partners")
}

