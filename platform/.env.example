# =============================================================
# ManPower Platform — Environment Configuration Template
# =============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# ----- Node / App -----
NODE_ENV=development
PORT=4000

# ----- Database (PostgreSQL — NEW TARGET) -----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Replace with your local Docker PostgreSQL credentials.
# NEVER use production credentials during development.
DATABASE_URL=postgresql://manpower_user:manpower_dev_password@localhost:5432/manpower_dev?schema=public

# ----- API -----
API_VERSION=v1
# Comma-separated list of allowed CORS origins for the API
CORS_ORIGINS=http://localhost:3000

# ----- Web (Next.js) -----
# The URL the Next.js app uses to reach the API.
# In production this would be your API domain.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ----- Security -----
# Secret used for signed cookies / JWT (min 32 chars, generate with: openssl rand -hex 32)
# This will be used in M2 Auth module — placeholder only for M1.
# APP_SECRET=replace_with_at_least_32_char_random_string

# ----- Logging -----
# 'trace' | 'debug' | 'info' | 'warn' | 'error' | 'fatal'
LOG_LEVEL=info

# ----- Authentication (M2) -----
# Opaque database session lifetime (1–720 hours)
SESSION_TTL_HOURS=24
# bcrypt work factor (10–15; 12 recommended)
BCRYPT_ROUNDS=12

# One-time local bootstrap only. Set these immediately before running:
#   pnpm db:bootstrap-admin
# Then REMOVE BOOTSTRAP_ADMIN_PASSWORD from your environment.
# Password policy: 12+ characters with upper/lowercase, number, and symbol.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.local
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=generate_a_unique_strong_password

# =============================================================
# IMPORTANT DATABASE NOTE
# =============================================================
# PostgreSQL is the NEW TARGET database for the modern system.
# The legacy MariaDB/MySQL database (in src/) is the SOURCE database
# and must NEVER be modified, read with production credentials,
# or connected to during development.
# =============================================================
